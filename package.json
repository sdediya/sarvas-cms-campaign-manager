{
  "name": "vas-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:hrm": "ng serve --hmr",
    "build:prod": "ng build --c production --output-path dist-temp/campaign-manager/prod",
    "build:staging": "ng build --c staging --output-path dist-temp/campaign-manager/staging",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "pm2_serve:prod": "pm2 start ecosystem.config.js --env='prod'",
    "pm2_serve:staging": "pm2 start ecosystem.config.js --env='staging'"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.0",
    "@angular/cdk": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-browser-dynamic": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@primeuix/themes": "^3.0.1",
    "@rxweb/reactive-form-validators": "^13.0.1",
    "express": "^4.21.0",
    "guid-typescript": "^1.0.9",
    "moment": "^2.29.4",
    "ngx-clipboard": "^16.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.10",
    "quill": "^1.3.7",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.0",
    "@angular/cli": "~21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@types/jasmine": "~4.3.0",
    "jasmine-core": "~4.5.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "typescript": "~5.9.3"
  }
}
